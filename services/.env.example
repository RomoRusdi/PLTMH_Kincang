# Salin menjadi services/.env lalu isi. File .env tidak boleh di-commit.

# --- Broker MQTT -------------------------------------------------------------
# Laptop pengembangan sudah menjalankan Mosquitto di 127.0.0.1:1883.
# Di lapangan: alamat ZeroTier server broker, mis. mqtt://10.147.17.5:1883
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Hanya untuk `npm run broker` (broker Node, dipakai jika Mosquitto tidak ada).
MQTT_PORT=1883

# --- Gateway -----------------------------------------------------------------
GATEWAY_CONFIG=config/gateway.json
BUFFER_FILE=gateway-buffer.jsonl

# --- Simulator PLC (pengembangan) -------------------------------------------
# normal | banjir | kering | radar-putus | plc-hang | panas
SIM_SCENARIO=normal

# --- Ingest (MQTT -> Supabase) ----------------------------------------------
# Project Settings > API. SERVICE ROLE key bersifat rahasia: hanya untuk
# service ingest di server tepercaya, jangan dimasukkan ke frontend/gateway.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
