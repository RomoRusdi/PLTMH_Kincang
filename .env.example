# Salin menjadi .env lalu isi dari Supabase: Project Settings > API.
# Anon key memang untuk browser; keamanan data dijaga oleh RLS di database.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_APP_NAME=Digihidrotech
# Sama dengan id stasiun di supabase-seed.sql
VITE_STATION_ID=5b0d6f2e-3c1a-4b8e-9f47-2d6a1c8e7b10
VITE_REALTIME_ENABLED=true
VITE_POLLING_INTERVAL_MS=5000
VITE_ALERT_POLLING_MS=3000
VITE_MOCK_DB=false
